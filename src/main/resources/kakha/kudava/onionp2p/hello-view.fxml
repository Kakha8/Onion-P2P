<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="kakha.kudava.onionp2p.HelloController">
    <VBox fx:id="authPane" alignment="CENTER" spacing="16" maxWidth="440" visible="false" managed="false">
        <Label fx:id="authTitle" text="Set up your account" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label fx:id="authMessage" wrapText="true" text="Checking local account…"/>
        <TextField fx:id="usernameField" promptText="Username" maxWidth="360"/>
        <PasswordField fx:id="passwordField" promptText="Password (at least 12 characters)" maxWidth="360"/>
        <VBox fx:id="confirmPasswordRow" spacing="8" alignment="CENTER" visible="false" managed="false">
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" maxWidth="360" onAction="#onAuthenticate"/>
        </VBox>
        <Button fx:id="authButton" text="Create account" onAction="#onAuthenticate"/>
        <ProgressIndicator fx:id="authProgress" prefWidth="28" prefHeight="28" maxWidth="28" maxHeight="28" visible="false" managed="false"/>
    </VBox>
    <VBox fx:id="appPane" alignment="CENTER" spacing="20.0" visible="false" managed="false">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Your public-key link" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Generate a link to share your public key with a contact." wrapText="true"/>
    <Button fx:id="generateButton" text="Generate public-key link" onAction="#onGenerateLink"/>
    <HBox fx:id="torProgressRow" alignment="CENTER" spacing="8" visible="false" managed="false">
        <ProgressIndicator fx:id="torProgress" prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
        <Label fx:id="torStatus" text="Starting Tor…"/>
    </HBox>
    <VBox fx:id="linkPanel" spacing="10" visible="false" managed="false">
        <Label text="Public-key link" labelFor="$contactLink"/>
        <TextField fx:id="contactLink" editable="false"/>
        <Button text="Copy link" onAction="#onCopyLink"/>
    </VBox>
    <Label fx:id="statusText" wrapText="true"/>
    <VBox spacing="10">
        <Label text="Import a contact's public-key link"/>
        <TextField fx:id="importLink" promptText="onionp2p://contact/v1/x25519/…" onAction="#onImportLink"/>
        <Button fx:id="importButton" text="Import link" onAction="#onImportLink"/>
        <VBox fx:id="addressPanel" spacing="8" visible="false" managed="false">
            <Label text="Contact rendezvous address"/>
            <TextField fx:id="importedAddress" editable="false"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <ProgressIndicator fx:id="pairingProgress" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
            <Label fx:id="importStatus" wrapText="true"/>
        </HBox>
    </VBox>
    <HBox alignment="CENTER" spacing="8">
        <ProgressIndicator fx:id="contactsProgress" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
        <Label text="Saved contacts"/>
    </HBox>
    <ListView fx:id="savedContacts" prefHeight="120" VBox.vgrow="ALWAYS"/>
    </VBox>
</StackPane>

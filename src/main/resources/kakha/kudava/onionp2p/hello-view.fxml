<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="kakha.kudava.onionp2p.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Your public-key link" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Generate a link to share your public key with a contact." wrapText="true"/>
    <Button fx:id="generateButton" text="Generate public-key link" onAction="#onGenerateLink"/>
    <VBox fx:id="linkPanel" spacing="10" visible="false" managed="false">
        <Label text="Public-key link" labelFor="$contactLink"/>
        <TextField fx:id="contactLink" editable="false"/>
        <Button text="Copy link" onAction="#onCopyLink"/>
    </VBox>
    <Label fx:id="statusText" wrapText="true"/>
    <VBox spacing="10">
        <Label text="Import a contact's public-key link"/>
        <TextField fx:id="importLink" promptText="onionp2p://contact/v1/x25519/…" onAction="#onImportLink"/>
        <Button fx:id="importButton" text="Import link" onAction="#onImportLink"/>
        <VBox fx:id="addressPanel" spacing="8" visible="false" managed="false">
            <Label text="Derived contact onion address"/>
            <TextField fx:id="importedAddress" editable="false"/>
        </VBox>
        <Label fx:id="importStatus" wrapText="true"/>
    </VBox>
</VBox>

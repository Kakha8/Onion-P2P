<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane fx:id="windowRoot" styleClass="app-root window-root" xmlns:fx="http://javafx.com/fxml" fx:controller="kakha.kudava.onionp2p.ui.HelloController">
    <top>
        <HBox fx:id="windowBar" styleClass="window-bar" alignment="CENTER_LEFT" spacing="0">
            <Label text="Onion-P2P" styleClass="window-title" graphicTextGap="7">
                <graphic>
                    <ImageView fitWidth="24" fitHeight="24" preserveRatio="true" smooth="true"
                               blendMode="LIGHTEN" mouseTransparent="true">
                        <image>
                            <Image url="@onion-owl.png" requestedWidth="48" requestedHeight="48" preserveRatio="true" smooth="true"/>
                        </image>
                    </ImageView>
                </graphic>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="minimizeButton" styleClass="window-control-button" onAction="#onMinimizeWindow"/>
            <Button fx:id="maximizeButton" styleClass="window-control-button" onAction="#onToggleMaximizeWindow"/>
            <Button fx:id="closeWindowButton" styleClass="window-control-button,window-close-button" onAction="#onCloseWindow"/>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="window-content">
            <VBox fx:id="authPane" styleClass="auth-card" alignment="CENTER" spacing="14" maxWidth="338"
                  visible="false" managed="false">
                <ImageView fitWidth="112" fitHeight="112" preserveRatio="true" smooth="true"
                           blendMode="LIGHTEN" mouseTransparent="true">
                    <image>
                        <Image url="@onion-owl.png" requestedWidth="224" requestedHeight="224" preserveRatio="true" smooth="true"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER" spacing="5">
                    <Label fx:id="authTitle" styleClass="auth-title" text="Onion-P2P"/>
                    <Label fx:id="authMessage" styleClass="auth-message" wrapText="true" textAlignment="CENTER"
                           text="Checking local account…"/>
                </VBox>
                <VBox styleClass="auth-fields" spacing="10">
                    <TextField fx:id="usernameField" promptText="Username"/>
                    <StackPane>
                        <PasswordField fx:id="passwordField" styleClass="auth-password-input" promptText="Password"/>
                        <TextField fx:id="revealedPasswordField" styleClass="auth-password-input" promptText="Password"
                                   visible="false" managed="false"/>
                        <Button fx:id="passwordVisibilityButton" styleClass="auth-password-toggle"
                                StackPane.alignment="CENTER_RIGHT" onAction="#onTogglePasswordVisibility">
                            <StackPane.margin><Insets right="4"/></StackPane.margin>
                        </Button>
                    </StackPane>
                    <VBox fx:id="confirmPasswordRow" visible="false" managed="false">
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm password"/>
                    </VBox>
                </VBox>
                <StackPane>
                    <Button fx:id="authButton" styleClass="auth-submit" text="Unlock" maxWidth="Infinity"
                            onAction="#onAuthenticate"/>
                    <ProgressIndicator fx:id="authProgress" styleClass="auth-progress" prefWidth="18" prefHeight="18"
                                       maxWidth="18" maxHeight="18" StackPane.alignment="CENTER_RIGHT"
                                       mouseTransparent="true" visible="false" managed="false">
                        <StackPane.margin><Insets right="12"/></StackPane.margin>
                    </ProgressIndicator>
                </StackPane>
            </VBox>
    <VBox fx:id="appPane" styleClass="app-shell" alignment="TOP_LEFT" spacing="0.0" visible="false" managed="false">
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
    </padding>

    <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">
        <VBox fx:id="messengerHost" spacing="4" minHeight="250"/>
        <VBox fx:id="addContactPane" styleClass="add-contact-pane" spacing="0" alignment="TOP_CENTER" visible="false" managed="false">
            <HBox styleClass="add-contact-header" alignment="CENTER_LEFT" spacing="14" maxWidth="760">
                <Button styleClass="add-contact-back" onAction="#onCloseAddContact" accessibleText="Back">
                    <graphic><SVGPath content="M14 5 L7 12 L14 19" styleClass="add-contact-back-glyph"/></graphic>
                </Button>
                <VBox spacing="3">
                    <Label text="Add a contact" styleClass="add-contact-title"/>
                    <Label text="Connect by exchanging trusted contact links." styleClass="add-contact-description"/>
                </VBox>
            </HBox>
            <VBox styleClass="add-contact-content" spacing="14" alignment="CENTER" maxWidth="720" VBox.vgrow="ALWAYS">
                <VBox styleClass="contact-action-card" spacing="12">
                    <VBox spacing="4">
                        <Label text="Share your link" styleClass="contact-card-title"/>
                        <Label text="Create your personal link, then send it to someone you trust." styleClass="add-contact-description" wrapText="true"/>
                    </VBox>
                    <Button fx:id="generateButton" styleClass="secondary-button contact-generate-button" text="Generate my link" onAction="#onGenerateLink"/>
                    <VBox fx:id="linkPanel" styleClass="contact-link-panel" spacing="8" visible="false" managed="false">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="contactLink" editable="false" promptText="Your public-key link" HBox.hgrow="ALWAYS"/>
                            <Button styleClass="secondary-button" text="Copy link" onAction="#onCopyLink"/>
                        </HBox>
                    </VBox>
                    <Label fx:id="statusText" styleClass="add-contact-description contact-action-status" wrapText="true"/>
                </VBox>
                <VBox styleClass="contact-action-card contact-add-section" spacing="12">
                    <VBox spacing="4">
                        <Label text="Add someone" styleClass="contact-card-title"/>
                        <Label text="Paste the contact link they shared with you to start pairing." styleClass="add-contact-description" wrapText="true"/>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="importLink" styleClass="contact-import-field" promptText="Paste a contact link" onAction="#onImportLink" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="importButton" styleClass="primary-button" text="Add contact" onAction="#onImportLink"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ProgressIndicator fx:id="pairingProgress" prefWidth="18" prefHeight="18" maxWidth="18" maxHeight="18" visible="false" managed="false"/>
                        <Label fx:id="importStatus" wrapText="true" styleClass="add-contact-description"/>
                    </HBox>
                    <VBox fx:id="addressPanel" styleClass="contact-link-panel" spacing="5" visible="false" managed="false">
                        <Label text="Contact rendezvous address" styleClass="add-contact-description"/>
                        <TextField fx:id="importedAddress" editable="false"/>
                    </VBox>
                </VBox>
                <Label text="Only add links you received directly from the person you want to contact." styleClass="contact-privacy-note" wrapText="true"/>
            </VBox>
        </VBox>
    </StackPane>
    </VBox>
        </StackPane>
    </center>
</BorderPane>
